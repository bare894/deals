{
  "manifest_version": 3,
  "name": "ShareDeals — Post this deal",
  "version": "1.0.0",
  "description": "One-click submission of the product page you're viewing to ShareDeals.",
  "action": {
    "default_title": "Post this page to ShareDeals",
    "default_icon": { "32": "icon32.png", "128": "icon128.png" }
  },
  "icons": { "32": "icon32.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["activeTab", "storage"]
}
